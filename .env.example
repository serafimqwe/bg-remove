# Copy to .env. All variables are prefixed BG_REMOVE_ and validated at startup (src/bg_remove/config.py).
BG_REMOVE_API_KEY=change-me                 # required; clients send it in the x-api-key header
BG_REMOVE_MODEL=birefnet-general-lite       # any rembg model name
BG_REMOVE_DEVICE=cpu                        # cpu | cuda  (cuda fails fast if the provider does not load)
BG_REMOVE_MAX_UPLOAD_MB=15
BG_REMOVE_REQUIRE_AUTH=true                 # false only for local dev
